    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 📊 Weather Forecast Model Evaluation & Training Visualizer\n",
        "\n",
        "This notebook provides interactive and static visualizations for:\n",
        "1. **Training Evolution**: Evolution of Loss (MSE), Accuracy (MAE °C vs target threshold), and Learning Rate decay across ALL models.\n",
        "2. **Out-of-Sample Predictions**: Multi-step predictions (TMAX, TMIN, TAVG) and 24-hour sequence profiles across ALL models."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# --- 1. Imports and Setup ---\n",
        "import json\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from pathlib import Path\n",
        "\n",
        "# Run automated visualization module\n",
        "from forecast_system.visualization import generate_all_visualizations\n",
        "\n",
        "print(\"Generating visualization figures...\")\n",
        "generate_all_visualizations(outputs_dir=\"report/outputs\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Evolution of Loss, Accuracy, and Learning Rate across ALL Models"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# --- 2. Training Evolution Visualizer ---\n",
        "outputs_path = Path(\"report/outputs\")\n",
        "all_hist_file = outputs_path / \"all_training_histories.json\"\n",
        "\n",
        "if all_hist_file.exists():
            with open(all_hist_file, 'r') as f:\n",
                all_histories = json.load(f)\n",
        "\n",
        "    print(f\"Loaded training history for {len(all_histories)} models: {list(all_histories.keys())}\")\n",
        "\n",
        "    fig, axes = plt.subplots(3, 1, figsize=(12, 14))\n",
        "    \n",
        "    # 1. Loss\n",
        "    for model_name, hist in all_histories.items():\n",
        "        if 'epochs' in hist and hist['epochs']:\n",
        "            epochs = [e['epoch'] for e in hist['epochs']]\n",
        "            val_loss = [e['val_loss'] for e in hist['epochs']]\n",
        "            axes[0].plot(epochs, val_loss, label=f\"{model_name} (Val Loss)\", marker='o')\n",
        "    axes[0].set_title(\"Validation Loss Evolution (MSE)\", fontsize=12, fontweight='bold')\n",
        "    axes[0].set_ylabel(\"MSE Loss\")\n",
        "    axes[0].grid(True)\n",
        "    axes[0].legend()\n",
        "\n",
        "    # 2. Accuracy\n",
        "    for model_name, hist in all_histories.items():\n",
        "        if 'epochs' in hist and hist['epochs']:\n",
        "            epochs = [e['epoch'] for e in hist['epochs']]\n",
        "            val_mae = [e['val_mae'] for e in hist['epochs']]\n",
        "            axes[1].plot(epochs, val_mae, label=f\"{model_name} (Val MAE)\", marker='s')\n",
        "        elif 'stages' in hist and hist['stages']:\n",
        "            stages = [s['stage'] for s in hist['stages']]\n",
        "            val_mae = [s['val_mae'] for s in hist['stages']]\n",
        "            axes[1].plot(stages, val_mae, label=f\"{model_name} (Val MAE)\", linestyle='--', marker='^')\n",
        "    axes[1].axhline(1.0, color='red', linestyle=':', label='Target MAE Threshold (1.0°C)')\n",
        "    axes[1].set_title(\"Validation Accuracy Evolution (MAE °C)\", fontsize=12, fontweight='bold')\n",
        "    axes[1].set_ylabel(\"MAE (°C)\")\n",
        "    axes[1].grid(True)\n",
        "    axes[1].legend()\n",
        "\n",
        "    # 3. Learning Rate\n",
        "    for model_name, hist in all_histories.items():\n",
        "        if 'epochs' in hist and hist['epochs'] and 'lr' in hist['epochs'][0]:\n",
        "            epochs = [e['epoch'] for e in hist['epochs']]\n",
        "            lrs = [e['lr'] for e in hist['epochs']]\n",
        "            axes[2].plot(epochs, lrs, label=f\"{model_name} LR\", marker='o')\n",
        "        elif 'stages' in hist and hist['stages'] and 'learning_rate' in hist['stages'][0]:\n",
        "            stages = [s['stage'] for s in hist['stages']]\n",
        "            lrs = [s['learning_rate'] for s in hist['stages']]\n",
        "            axes[2].plot(stages, lrs, label=f\"{model_name} LR\", linestyle='--', marker='d')\n",
        "    axes[2].set_yscale('log')\n",
        "    axes[2].set_title(\"Learning Rate Decay Evolution (Log Scale)\", fontsize=12, fontweight='bold')\n",
        "    axes[2].set_ylabel(\"Learning Rate\")\n",
        "    axes[2].set_xlabel(\"Epoch / Stage Step\")\n",
        "    axes[2].grid(True)\n",
        "    axes[2].legend()\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"History file not found.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Predictions of ALL Models (2026 Test Set)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# --- 3. Predictions Visualizer ---\n",
        "pred_file = outputs_path / \"test_predictions.json\"\n",
        "if pred_file.exists():\n",
        "    with open(pred_file, 'r') as f:\n",
        "        pred_data = json.load(f)\n",
        "\n",
        "    models_pred = pred_data.get('predictions', {})\n",
        "    print(f\"Loaded predictions for {len(models_pred)} models: {list(models_pred.keys())}\")\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(14, 6))\n",
        "    ax.plot(pred_data['actual_next24_tmax'], label='Actual Next-24h TMAX', color='black', linewidth=2.5)\n",
        "\n",
        "    for m_name, p_dict in models_pred.items():\n",
        "        if 'tmax' in p_dict:\n",
        "            ax.plot(p_dict['tmax'], label=m_name, alpha=0.8)\n",
        "\n",
        "    ax.set_title(\"Next-Day TMAX Predictions Across All Models vs Actual\", fontsize=13, fontweight='bold')\n",
        "    ax.set_ylabel(\"Temperature (°C)\")\n",
        "    ax.set_xlabel(\"Sample Window Steps\")\n",
        "    ax.grid(True)\n",
        "    ax.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"Predictions file not found.\")"
      ]
    }
  ]
}